{
  "id": "full",
  "name": "Full",
  "description": "The whole team: the scout explores, the spec writer writes what to build for your approval, the planner writes how for your approval, the coder and tester work in parallel, QA checks the running software, enki runs the tests, and the reviewer reads the change. Problems go back to the coder, and failing tests to the tester as well, up to 3 times per kind.",
  "version": 3,
  "nodes": [
    {"id": "start", "kind": "start"},
    {"id": "scout", "agent": "scout"},
    {"id": "spec-writer", "agent": "spec-writer"},
    {"id": "spec-approval", "kind": "spec-approval"},
    {"id": "planner", "agent": "planner"},
    {"id": "approval", "kind": "approval"},
    {"id": "coder", "agent": "coder"},
    {"id": "tester", "agent": "tester"},
    {"id": "qa", "agent": "qa"},
    {"id": "verify", "kind": "verify"},
    {"id": "reviewer", "agent": "reviewer"},
    {"id": "end", "kind": "end"}
  ],
  "edges": [
    {"from": "start", "on": "request", "to": "scout"},
    {"from": "scout", "on": "done", "to": "spec-writer"},
    {"from": "spec-writer", "on": "ready", "to": "spec-approval"},
    {"from": "spec-approval", "on": "approved", "to": "planner"},
    {"from": "spec-approval", "on": "changes", "to": "spec-writer"},
    {"from": "planner", "on": "ready", "to": "approval"},
    {"from": "planner", "on": "spec", "to": "spec-writer"},
    {"from": "approval", "on": "approved", "to": ["coder", "tester"]},
    {"from": "approval", "on": "change-plan", "to": "planner"},
    {"from": "approval", "on": "change-spec", "to": "spec-writer"},
    {"from": "coder", "on": "done", "to": ["verify", "qa"]},
    {"from": "tester", "on": "done", "to": "verify"},
    {"from": "verify", "on": "pass", "to": "reviewer"},
    {"from": "verify", "on": "fail", "to": ["coder", "tester"], "max": 3},
    {"from": "qa", "on": "pass", "to": "end"},
    {"from": "qa", "on": "bug", "to": ["coder", "tester"], "max": 3},
    {"from": "reviewer", "on": "approve", "to": "end"},
    {"from": "reviewer", "on": "changes", "to": "coder", "max": 3}
  ]
}
